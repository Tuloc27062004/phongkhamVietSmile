# Copy this file to `.env` and fill in real values from Supabase Dashboard.
# NEVER commit `.env` or real secrets to git.

# Supabase Project Configuration
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""

# Client-Side Publishable / Anon Keys (safe for browser, but keep out of git anyway)
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_ANON_KEY=""

# Database Connection String (Direct Postgres Access)
DATABASE_URL=""

# Backend / Server-side variables
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only key used to encrypt each clinic's Zalo App Secret at rest (AES-256-GCM).
# Generate a long random value once per environment, e.g.: openssl rand -base64 32
# Rotating this value makes previously-saved Zalo App Secrets undecryptable — reconfigure Zalo per clinic after rotating.
ZALO_CONFIG_ENCRYPTION_KEY=""

# Server-only key used to encrypt each clinic's Resend API Key at rest (AES-256-GCM).
# Generate a long random value once per environment, e.g.: openssl rand -base64 32
# Rotating this value makes previously-saved Resend API Keys undecryptable — reconfigure Email per clinic after rotating.
RESEND_CONFIG_ENCRYPTION_KEY=""

# Shared secret checked (as a Bearer token) by /api/public/notifications/dispatch — the endpoint
# that sends appointment reminder emails and doctor daily-schedule emails in batch. Only needed if
# you wire an external scheduler (cron) to call it automatically; manual sends from the UI don't need it.
NOTIFICATIONS_DISPATCH_SECRET=""
