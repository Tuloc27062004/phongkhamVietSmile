# Copy file nay thanh .env va dien gia tri that.

# Thong tin ket noi may cham cong ZKTeco (TCP/IP)
DEVICE_IP=192.168.1.202
DEVICE_PORT=4370
DEVICE_SERIAL=8116243500205
DEVICE_NAME=May le tan (MCC00001)

# Endpoint that cua he thong GZV Clinic Platform ban da trien khai — KHONG dung link preview/localhost
# khi chay that tai phong kham. Xem dung link nay tai: He thong > Ket noi Agent cham cong.
API_ENDPOINT=https://ten-mien-that-cua-ban/api/public/device/events

# Khoa API rieng cho Agent nay — tao tai He thong > Ket noi Agent cham cong (chi hien 1 lan luc tao).
API_KEY=dan-khoa-agent-vao-day

# Tuy chon
RECONNECT_DELAY_MS=10000
BATCH_FLUSH_MS=3000
MAX_CONNECTION_LIFETIME_MS=21600000
